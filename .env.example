# Copy this file to .env.local and fill in your keys
JWT_SECRET=change-this-to-a-long-random-secret

# Free database (optional) - MongoDB Atlas
# Leave empty to use local JSON files
# Get one free at https://www.mongodb.com/atlas
MONGODB_URI=

# AI providers (optional)
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Email (optional) - SendGrid
SENDGRID_API_KEY=
